{
  "name": "coding-accompany-pets",
  "private": true,
  "version": "1.1.0",
  "description": "会听写、会截图、会识图的桌面编码搭子",
  "scripts": {
    "dist": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.codingaccompanypets.app",
    "productName": "coding-accompany-pets",
    "directories": {
      "output": "app/dist-exe",
      "app": "app"
    },
    "asar": false,
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "vendor/**/*",
      "build/icon.ico",
      "preload.js",
      "package.json"
    ],
    "win": {
      "icon": "app/build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": false,
      "shortcutName": "coding-accompany-pets",
      "artifactName": "coding-accompany-pets-Setup-${version}.exe"
    },
    "electronVersion": "31.7.7",
    "electronDist": "app/node_modules/electron/dist",
    "portable": {
      "artifactName": "coding-accompany-pets-${version}-Portable.exe"
    }
  }
}
